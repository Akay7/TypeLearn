# Loaded by direnv on entering this directory, so everything here is scoped to
# this project. Run `direnv allow` once after cloning.

# Per-checkout overrides, git-ignored, so pinning a worktree's identity never
# shows up as a modification. See .envrc.local.example. Sourced first: the
# settings below build on what it may have set.
source_env_if_exists .envrc.local

# --- Container runtime --------------------------------------------------------
# Docker or rootless Podman, whichever you use. Name one side and the other is
# filled in here, because Tilt builds through DOCKER_HOST while kind loads
# through KIND_EXPERIMENTAL_PROVIDER, and half-configuring leaves images the
# cluster cannot pull. (The Tiltfile refuses to start on a mismatch; this is what
# keeps you from having to see that.)
if [ "${KIND_EXPERIMENTAL_PROVIDER:-}" = "podman" ]; then
	[ -n "${DOCKER_HOST:-}" ] || export DOCKER_HOST="unix:///run/user/$(id -u)/podman/podman.sock"
	# Podman's API implements no BuildKit gRPC session.
	export DOCKER_BUILDKIT=0
elif [ "${DOCKER_HOST:-}" != "${DOCKER_HOST#*podman}" ]; then
	export KIND_EXPERIMENTAL_PROVIDER=podman
	export DOCKER_BUILDKIT=0
fi

# --- Tilt's UI port -----------------------------------------------------------
# Tilt binds its web server before it evaluates the Tiltfile, so this cannot be
# chosen there. Derived from the same worktree identity as the namespace and the
# Gateway port, so several checkouts stay attachable at once.
export TILT_PORT="$(./scripts/worktree-env.sh tilt-port)"
