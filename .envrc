# Loaded by direnv on cd, unloaded on leaving — so everything here applies to
# this project only. Run `direnv allow` once after cloning.
#
# --- Container runtime (temporary) -------------------------------------------
# This project runs on Docker for now.
#
# Tilt builds images through DOCKER_HOST, and kind loads them into the cluster
# through KIND_EXPERIMENTAL_PROVIDER. When those two name different runtimes the
# build succeeds, the load quietly finds nothing, and the cluster falls back to
# pulling the images from Docker Hub — an ImagePullBackOff that says nothing
# about the cause. Clearing both leaves Docker on both sides, and it is cleared
# rather than set because a shell profile that prefers Podman would otherwise
# reach in here and only half-apply.
#
# Podman is a fine choice for this project; it needs kind 0.33+, because kind
# 0.32 cannot drive podman 6 at all. To switch, replace these two lines with the
# Podman export block from the README.
unset KIND_EXPERIMENTAL_PROVIDER
unset DOCKER_HOST

# --- This checkout, if it wants pinning --------------------------------------
# .envrc.local is git-ignored, so a worktree can pin its own offset without
# every checkout showing up as modified. See .envrc.local.example.
source_env_if_exists .envrc.local
