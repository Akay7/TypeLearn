{
  // The whole stack runs in the cluster — `tilt up`, then http://localhost:8500.
  // Source is synced into the running pods, so an edit takes effect without
  // anything here being pressed.
  //
  // What is here is for stepping through code with a debugger, which a synced
  // pod cannot give you. Both configurations need a database, and the cluster's
  // is not exposed on the host, so port-forward it first:
  //
  //   kubectl port-forward svc/postgres-rw 5432:5432
  //   kubectl get secret postgres-app -o jsonpath='{.data.password}' | base64 -d
  //
  // and put the printed password in POSTGRES_PASSWORD below (or export it before
  // launching VS Code). It is generated by CloudNativePG and is never written to
  // a file in this repository, which is why this cannot be an `envFile`.
  //
  // Requires `uv sync` in src/backend, and `npm install` in src/frontend.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Django server (needs a port-forward)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/backend/manage.py",
      "args": ["runserver", "--noreload"],
      "cwd": "${workspaceFolder}/src/backend",
      "env": {
        "POSTGRES_HOST": "127.0.0.1",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "typelearn",
        "POSTGRES_USER": "typelearn",
        "POSTGRES_PASSWORD": "${env:POSTGRES_PASSWORD}",
        "DJANGO_DEBUG": "true",
        "DJANGO_SECRET_KEY": "dev-only-not-a-secret",
        // The host runserver has no Gateway in front of it, so it is its own
        // origin on 8000 rather than one of several paths behind :8500.
        "DJANGO_ALLOWED_HOSTS": "localhost,127.0.0.1",
        // Clips live on the shared host directory the cluster mounts, so a
        // host-run server serves the same audio the pods do.
        "MEDIA_ROOT": "${workspaceFolder}/data/media"
      },
      "django": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: load corpus (needs a port-forward)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/backend/manage.py",
      // Ingestion takes the release directory as an argument — it is never
      // hardcoded, so the prompt asks for it each run. The Tilt UI's "Ingest the
      // corpus" button is the usual way in; this one is for stepping through it.
      "args": ["load_corpus", "${input:corpusPath}"],
      "cwd": "${workspaceFolder}/src/backend",
      "env": {
        "POSTGRES_HOST": "127.0.0.1",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "typelearn",
        "POSTGRES_USER": "typelearn",
        "POSTGRES_PASSWORD": "${env:POSTGRES_PASSWORD}",
        "DJANGO_DEBUG": "true",
        "DJANGO_SECRET_KEY": "dev-only-not-a-secret",
        "MEDIA_ROOT": "${workspaceFolder}/data/media"
      },
      "django": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend: Vite dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/src/frontend",
      // Standalone, and deliberately not paired with the backend config above:
      // running both on the host is the two-origin arrangement the cluster
      // exists to remove. This is for debugging the SPA on its own, the way the
      // browser suite drives it.
      //
      // NO_COLOR is what makes the pattern below work: with colors on, Vite
      // wraps the URL in escape codes ("http://localhost:" then a bolded port),
      // so no regex matches it as one contiguous string and the browser never
      // opens. Plain output costs colors in this one terminal.
      "env": { "NO_COLOR": "1" },
      // Vite prints "Local:   http://localhost:5173/" when it is ready; that
      // line is what opens the browser, so nothing races the server startup.
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/src/frontend"
      }
    }
  ],
  "inputs": [
    {
      "id": "corpusPath",
      "type": "promptString",
      "description": "Path to the Common Voice release directory (e.g. .../cv-corpus-25.0-2026-03-09)"
    }
  ]
}
