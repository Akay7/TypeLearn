{
  // The Testing view runs the backend suite on the host, against the database
  // in the cluster. `tilt up` forwards it (the "postgres-forward" resource) and
  // writes the credentials to .tilt/backend-test.env, which is what envFile
  // below points at — so a test is run and debugged like any other Python code:
  // click the gutter icon, set a breakpoint, step. No attach step, no pod.
  //
  // The suite that *counts* still runs in the pod — the Tilt UI's "Run backend
  // tests" button, and CI — inside the image that ships. This is for iterating.
  //
  // Needs the host interpreter to actually have the test dependencies:
  //
  //   cd src/backend && uv sync
  //
  // If tests fail here with "connection refused", the stack is not up: the
  // forward only exists while Tilt is running.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  // pytest's config lives in src/backend/pyproject.toml, so discovery has to
  // start there rather than at the repo root.
  "python.testing.cwd": "${workspaceFolder}/src/backend",
  "python.testing.pytestArgs": [],
  // Generated by Tilt while the database is forwarded. Naming it explicitly
  // also keeps the extension off its default, ${workspaceFolder}/.env — that
  // file is the *cluster's* configuration, and its MEDIA_ROOT=/app/media and
  // CORPUS_PATH=/corpus are paths that exist only inside a container.
  "python.envFile": "${workspaceFolder}/.tilt/backend-test.env",
  // `uv sync` in src/backend puts an interpreter here, and VS Code finds it on
  // its own; this is only the default until one is picked explicitly.
  "python.defaultInterpreterPath": "${workspaceFolder}/src/backend/.venv/bin/python"
}
