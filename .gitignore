# Downloaded corpus, generated datasets, and copied media
data/

# Credentials. A safety net for any *.env a tool drops here; the tracked
# examples are named the other way round (.env.example) and are not matched.
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Django
*.sqlite3
/src/backend/media/
/src/backend/staticfiles/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Editors and OS
.DS_Store
*.swp

# Local configuration, read by the cluster and by host-run management commands.
.env

# Tilt scratch: the generated chart values and kind config. Also listed in
# .tiltignore, because Tilt watches the values files it renders from and would
# otherwise reload in a loop on its own output.
.tilt/

# direnv: .envrc is committed (it pins the container runtime for everyone);
# only the per-checkout override is ignored.
.envrc.local
