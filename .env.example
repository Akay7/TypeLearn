# Copy to .env. Read by the cluster (the Tiltfile builds a ConfigMap from it)
# and by any management command run on the host, so a setting lives in one place.
# .env is git-ignored; this example carries no secret.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-not-a-secret-change-me
# The Gateway forwards the browser's Host header, and probes arrive on the pod IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,*

# Where the ingested clips live. In the cluster this is the shared volume's
# mount point; on the host, leave it unset to use src/backend/media.
MEDIA_ROOT=/app/media

# The Common Voice release, read in place and never committed or copied into an
# image. Inside the cluster it is wherever k8s/kind.yaml mounts it; set
# TYPELEARN_CORPUS_DIR on the host to say where it really is.
CORPUS_PATH=/corpus
